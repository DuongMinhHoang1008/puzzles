{
  "name": "puzzle-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:engine": "node ../tools/web/build-engine.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run build:engine && npm run build:frontend",
    "build:frontend": "npm run typecheck && node ../tools/web/check-assets.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
